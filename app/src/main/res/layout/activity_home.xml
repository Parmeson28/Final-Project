<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hs_bg">

    <!-- CONTEÚDO PRINCIPAL -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hs_bg">

        <!-- TOPBAR -->
        <LinearLayout
            android:id="@+id/topbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/hs_accent"
            android:padding="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:padding="8dp"
                android:contentDescription="Abrir menu"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@android:color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/tvTopbarBrand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Harpia Fitness"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvTopbarSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gestão rápida — Home"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnNotifications"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Notificações"
                android:src="@android:drawable/ic_dialog_email"
                app:tint="@android:color/white" />
        </LinearLayout>

        <!-- CONTEÚDO HOME -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/homeScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/topbar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- HERO -->
                <LinearLayout
                    android:id="@+id/cardHero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_dark"
                    android:padding="14dp"
                    android:orientation="horizontal"
                    android:elevation="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bem vindo(a) de volta!"
                            android:textColor="@color/hs_muted"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvUsername"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gustavo Petry"
                            android:textColor="@color/hs_text"
                            android:textStyle="bold"
                            android:textSize="20sp"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tvGymName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nome da Academia: Harpia Fitness"
                            android:textColor="@color/hs_muted"
                            android:textSize="13sp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAvatarHF"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:gravity="center"
                        android:text="HF"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="@color/hs_accent"
                        android:background="@drawable/bg_card_dark" />
                </LinearLayout>

                <!-- ASSINATURA ATUAL -->
                <LinearLayout
                    android:id="@+id/cardSubscription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_dark"
                    android:padding="14dp"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/tvSubTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Assinatura atual"
                            android:textColor="@color/hs_text"
                            android:textStyle="bold"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvLastPayment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Último pagamento: 26/11/2025"
                            android:textColor="@color/hs_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- summary-grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@color/hs_panel"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Plano atual"
                                android:textColor="@color/hs_muted"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvPlan"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mensal"
                                android:textStyle="bold"
                                android:textColor="@color/hs_text"
                                android:textSize="16sp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@color/hs_panel"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:layout_marginStart="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Status"
                                android:textColor="@color/hs_muted"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ativo"
                                android:textStyle="bold"
                                android:textColor="@color/hs_accent"
                                android:textSize="16sp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- actions -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <Button
                            android:id="@+id/btnChangePlan"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:background="@drawable/bg_btn_primary"
                            android:text="Alterar Plano"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnGoToAccount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:layout_marginStart="10dp"
                            android:background="@android:color/transparent"
                            android:text="Conta"
                            android:textAllCaps="false"
                            android:textColor="@color/hs_text"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- quick menu -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/tileTreinos"
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_card_dark"
                                android:orientation="vertical"
                                android:padding="12dp"
                                android:layout_marginEnd="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Treinos"
                                    android:textColor="@color/hs_muted"
                                    android:textSize="13sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ver"
                                    android:textColor="@color/hs_text"
                                    android:textStyle="bold"
                                    android:textSize="16sp"
                                    android:layout_marginTop="6dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/tileCobrancas"
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_card_dark"
                                android:orientation="vertical"
                                android:padding="12dp"
                                android:layout_marginEnd="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Cobranças"
                                    android:textColor="@color/hs_muted"
                                    android:textSize="13sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Gerenciar"
                                    android:textColor="@color/hs_text"
                                    android:textStyle="bold"
                                    android:textSize="16sp"
                                    android:layout_marginTop="6dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/tileLogout"
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_card_dark"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Sair"
                                    android:textColor="@color/hs_muted"
                                    android:textSize="13sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Logout"
                                    android:textColor="@color/hs_text"
                                    android:textStyle="bold"
                                    android:textSize="16sp"
                                    android:layout_marginTop="6dp" />
                            </LinearLayout>

                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvHomeFooter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dica: use o menu para navegar rápido entre as seções."
                    android:textColor="@color/hs_muted"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginTop="18dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- DRAWER LATERAL -->
    <LinearLayout
        android:id="@+id/leftDrawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/hs_accent"
        android:padding="18dp">

        <!-- brand / usuário -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/drawerAvatar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:text="HF"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@android:color/white"
                android:background="#113B22" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/drawerAcademy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Harpia Fitness"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@android:color/white" />

                <TextView
                    android:id="@+id/drawerWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bem vindo(a) de volta! Gustavo"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- info plano -->
        <LinearLayout
            android:id="@+id/drawerInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#2D113B22"
            android:padding="12dp"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Plano atual"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/drawerPlan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mensal"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Status"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/drawerStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ativo"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Último pagamento"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/drawerLastPayment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="26/11/2025"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnDrawerChangePlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@android:color/white"
                android:text="Alterar Plano"
                android:textColor="@color/hs_accent"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- navegação -->
        <Button
            android:id="@+id/navConta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@android:color/transparent"
            android:text="Conta"
            android:textAllCaps="false"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/navTreinos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:text="Treinos"
            android:textAllCaps="false"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/navCobrancas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:text="Cobranças"
            android:textAllCaps="false"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/navSair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:text="Sair"
            android:textAllCaps="false"
            android:textColor="@color/hs_danger" />

        <TextView
            android:id="@+id/drawerFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="© Harpia Fitness"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
