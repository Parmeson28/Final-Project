<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient"
    android:padding="28dp">

    <ScrollView
        android:id="@+id/scrollRegister"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/register_wrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- LOGO -->
            <LinearLayout
                android:id="@+id/register_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginBottom="18dp">

                <ImageView
                    android:id="@+id/imgLogoRegister"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:src="@drawable/harpysystem" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tvCadBrandTop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HARPY"
                        android:textColor="@color/hs_text"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:fontFamily="sans-serif-black" />

                    <TextView
                        android:id="@+id/tvCadBrandBottom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SYSTEMS"
                        android:textColor="@color/hs_accent"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:fontFamily="sans-serif-black" />
                </LinearLayout>
            </LinearLayout>

            <!-- CARD / FORM -->
            <LinearLayout
                android:id="@+id/register_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_login_card"
                android:padding="18dp"
                android:elevation="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRegisterTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Criar uma conta"
                    android:textColor="@color/hs_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRegisterLead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preencha os dados abaixo para cadastrar-se."
                    android:textColor="@color/hs_muted"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />

                <!-- Nome completo -->
                <LinearLayout
                    android:id="@+id/fieldFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nome completo"
                        android:textColor="@color/hs_muted"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nome sobrenome"
                        android:padding="10dp"
                        android:background="@color/hs_input"
                        android:textColor="@color/hs_text"
                        android:textColorHint="#2DFFFFFF"
                        android:textSize="14sp"
                        android:inputType="textPersonName" />

                    <TextView
                        android:id="@+id/tvNameError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Informe seu nome completo."
                        android:textSize="13sp"
                        android:textColor="@color/hs_danger"
                        android:visibility="gone"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Email -->
                <LinearLayout
                    android:id="@+id/fieldEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:textColor="@color/hs_muted"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="example@email.com"
                        android:padding="10dp"
                        android:background="@color/hs_input"
                        android:textColor="@color/hs_text"
                        android:textColorHint="#2DFFFFFF"
                        android:textSize="14sp"
                        android:inputType="textEmailAddress" />

                    <TextView
                        android:id="@+id/tvEmailError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email inválido."
                        android:textSize="13sp"
                        android:textColor="@color/hs_danger"
                        android:visibility="gone"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- CPF -->
                <LinearLayout
                    android:id="@+id/fieldCpf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CPF"
                        android:textColor="@color/hs_muted"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etCpf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="XXX.XXX.XXX-XX"
                        android:padding="10dp"
                        android:background="@color/hs_input"
                        android:textColor="@color/hs_text"
                        android:textColorHint="#2DFFFFFF"
                        android:textSize="14sp"
                        android:inputType="number" />

                    <TextView
                        android:id="@+id/tvUserError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Por favor informe email ou CPF válido."
                        android:textSize="13sp"
                        android:textColor="@color/hs_danger"
                        android:visibility="gone"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <!-- Grid 2 colunas: senha / confirmar senha -->
                <LinearLayout
                    android:id="@+id/gridPasswords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <!-- senha -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Senha"
                            android:textColor="@color/hs_muted"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/password_wrap_register"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp">

                            <EditText
                                android:id="@+id/etPassword"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:hint="\@SenhaForte123"
                                android:padding="10dp"
                                android:background="@color/hs_input"
                                android:textColor="@color/hs_text"
                                android:textColorHint="#2DFFFFFF"
                                android:textSize="14sp"
                                android:inputType="textPassword"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent" />

                            <ImageButton
                                android:id="@+id/btnTogglePasswordRegister"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@android:color/transparent"
                                android:src="@android:drawable/ic_menu_view"
                                app:tint="@color/hs_muted"
                                android:contentDescription="Mostrar senha"
                                app:layout_constraintEnd_toEndOf="@id/etPassword"
                                app:layout_constraintTop_toTopOf="@id/etPassword"
                                app:layout_constraintBottom_toBottomOf="@id/etPassword" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <TextView
                            android:id="@+id/tvPassError"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Senha deve ter ao menos 6 caracteres."
                            android:textSize="13sp"
                            android:textColor="@color/hs_danger"
                            android:visibility="gone"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- confirmar senha -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Confirmar senha"
                            android:textColor="@color/hs_muted"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/password_confirm_wrap"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp">

                            <EditText
                                android:id="@+id/etPasswordConfirm"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:hint="\@SenhaForte123"
                                android:padding="10dp"
                                android:background="@color/hs_input"
                                android:textColor="@color/hs_text"
                                android:textColorHint="#2DFFFFFF"
                                android:textSize="14sp"
                                android:inputType="textPassword"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent" />

                            <ImageButton
                                android:id="@+id/btnTogglePasswordConfirm"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@android:color/transparent"
                                android:src="@android:drawable/ic_menu_view"
                                app:tint="@color/hs_muted"
                                android:contentDescription="Mostrar senha"
                                app:layout_constraintEnd_toEndOf="@id/etPasswordConfirm"
                                app:layout_constraintTop_toTopOf="@id/etPasswordConfirm"
                                app:layout_constraintBottom_toBottomOf="@id/etPasswordConfirm" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <TextView
                            android:id="@+id/tvPassConfirmError"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="As senhas não coincidem."
                            android:textSize="13sp"
                            android:textColor="@color/hs_danger"
                            android:visibility="gone"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>


                <!-- Lembrar senha + link Entrar -->
                <LinearLayout
                    android:id="@+id/rowRememberLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <CheckBox
                        android:id="@+id/cbRememberRegister"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lembrar senha"
                        android:textColor="@color/hs_muted"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvGoToLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Entrar"
                        android:textColor="@color/hs_accent"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Botão Cadastrar -->
                <Button
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="44dp"
                    android:background="@drawable/bg_btn_primary"
                    android:text="Cadastrar"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- helper -->
                <TextView
                    android:id="@+id/tvTermsHelper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ao se cadastrar, você concorda com os termos do serviço."
                    android:textColor="@color/hs_muted"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- foot-links -->
            <LinearLayout
                android:id="@+id/register_footer_links"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvAlreadyHaveAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Já tenho conta — Entrar"
                    android:textColor="@color/hs_accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tvHelp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  •  Ajuda"
                    android:textColor="@color/hs_muted"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>


        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
