<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient"
    android:padding="28dp">

    <!-- wrap principal (equivalente à .wrap) -->
    <LinearLayout
        android:id="@+id/login_wrap"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- LOGO -->
        <LinearLayout
            android:id="@+id/logo_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/harpysystem"
                android:contentDescription="@string/app_name" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvBrandTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HARPY"
                    android:textColor="@color/hs_text"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/tvBrandSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SYSTEMS"
                    android:textColor="@color/hs_accent"
                    android:textSize="25sp"
                    android:letterSpacing="0.06"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginTop="-2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- CARD (equivalente à .card) -->
        <LinearLayout
            android:id="@+id/login_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_login_card"
            android:padding="20dp"
            android:elevation="10dp"
            android:layout_marginTop="8dp">

            <!-- título + lead -->
            <TextView
                android:id="@+id/tvLoginTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Entrar no sistema"
                android:textColor="@color/hs_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLoginLead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Insira seu Email ou CPF e sua senha para acessar."
                android:textColor="@color/hs_muted"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <!-- Campo: Email ou CPF (.field) -->
            <LinearLayout
                android:id="@+id/fieldUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tvUserLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email ou CPF"
                    android:textColor="@color/hs_muted"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Insira o Email ou o CPF"
                    android:inputType="textEmailAddress"
                    android:padding="12dp"
                    android:textColor="@color/hs_text"
                    android:textColorHint="#2DFFFFFF"
                    android:background="@color/hs_input"
                    android:fontFamily="sans-serif"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvUserError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Por favor informe email ou CPF válido."
                    android:textSize="13sp"
                    android:textColor="@color/hs_danger"
                    android:visibility="gone"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Campo: Senha (.field + .password-wrap) -->
            <LinearLayout
                android:id="@+id/fieldPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tvPasswordLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Senha"
                    android:textColor="@color/hs_muted"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/password_wrap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="Insira a senha"
                        android:inputType="textPassword"
                        android:padding="12dp"
                        android:textColor="@color/hs_text"
                        android:textColorHint="#2DFFFFFF"
                        android:background="@color/hs_input"
                        android:fontFamily="sans-serif"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <ImageButton
                        android:id="@+id/btnTogglePassword"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="Mostrar senha"
                        android:src="@android:drawable/ic_menu_view"
                        android:padding="4dp"
                        app:tint="@color/hs_muted"
                        app:layout_constraintEnd_toEndOf="@id/etPassword"
                        app:layout_constraintTop_toTopOf="@id/etPassword"
                        app:layout_constraintBottom_toBottomOf="@id/etPassword" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tvPasswordError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A senha deve ter ao menos 4 caracteres."
                    android:textSize="13sp"
                    android:textColor="@color/hs_danger"
                    android:visibility="gone"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- linha: lembrar / esqueci (.row-between) -->
            <LinearLayout
                android:id="@+id/rowRememberForgot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <CheckBox
                    android:id="@+id/cbRemember"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lembrar-me"
                    android:textColor="@color/hs_muted"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Esqueci a senha"
                    android:textColor="@color/hs_muted"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- botão Entrar -->
            <Button
                android:id="@+id/btnEnter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="44dp"
                android:background="@drawable/bg_btn_primary"
                android:text="Entrar"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- footer dentro do card -->
            <LinearLayout
                android:id="@+id/card_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNoAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ainda não tem cadastro? "
                    android:textColor="@color/hs_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvCreateAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Criar conta"
                    android:textColor="@color/hs_accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

        </LinearLayout> <!-- /login_card -->

    </LinearLayout> <!-- /login_wrap -->

</androidx.constraintlayout.widget.ConstraintLayout>
