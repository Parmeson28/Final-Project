<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hs_bg">

    <!-- CONTEÚDO PRINCIPAL -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hs_bg">

        <!-- TOPBAR verde -->
        <LinearLayout
            android:id="@+id/topbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/hs_accent"
            android:padding="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_btn_primary"
                android:padding="8dp"
                android:contentDescription="Abrir menu"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@android:color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/tvTopbarBrand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Harpia Fitness"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvTopbarSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gestão rápida — Home"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnNotifications"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="Notificações"
                android:src="@android:drawable/ic_dialog_email"
                app:tint="@android:color/white" />
        </LinearLayout>

        <!-- CONTEÚDO SCROLLÁVEL -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollSair"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/topbar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- CARD central -->
                <LinearLayout
                    android:id="@+id/cardSair"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:layout_marginTop="40dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/tvSairTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tem certeza que deseja sair?"
                        android:textColor="@color/hs_text"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvSairSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Você será desconectado da sua conta neste dispositivo."
                        android:textColor="@color/hs_muted"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btnCancelarSair"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:background="@android:color/transparent"
                            android:text="Cancelar"
                            android:textAllCaps="false"
                            android:textColor="@color/hs_text"
                            android:textStyle="bold"
                            android:layout_marginEnd="12dp" />

                        <Button
                            android:id="@+id/btnConfirmarSair"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:background="@drawable/bg_btn_primary"
                            android:text="Sair"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- DRAWER (sidebar) -->
    <LinearLayout
        android:id="@+id/leftDrawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/hs_accent"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/drawerAvatar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:text="HF"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@android:color/white"
                android:background="#113B22" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/drawerAcademy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Harpia Fitness"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@android:color/white" />

                <TextView
                    android:id="@+id/drawerWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bem vindo(a) de volta! Gustavo"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- info card -->
        <LinearLayout
            android:id="@+id/drawerInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#2D113B22"
            android:padding="12dp"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:gravity="space_between">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Plano atual"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/drawerPlan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mensal"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Status"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/drawerStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ativo"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Último pagamento"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/drawerLastPayment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="26/11/2025"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnDrawerChangePlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@android:color/white"
                android:text="Alterar Plano"
                android:textColor="@color/hs_accent"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- navegação -->
        <Button
            android:id="@+id/navConta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@android:color/transparent"
            android:text="Conta"
            android:textAllCaps="false"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/navTreinos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:text="Treinos"
            android:textAllCaps="false"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/navCobrancas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:text="Cobranças"
            android:textAllCaps="false"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/navSair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:text="Sair"
            android:textAllCaps="false"
            android:textColor="@color/hs_danger" />

        <TextView
            android:id="@+id/drawerFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:text="© Harpia Fitness"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:gravity="center"/>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
